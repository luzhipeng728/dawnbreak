{
 "_meta": {
  "about": "鬼剑士（男）逐技能官方规格，给 test/skillaudit.mjs --compare 用。数值按本作尺度（像素距离与官方大致 1:1；等级按 SKILLS_OFFICIAL_common.md 第 7 节压缩；冷却写官方现版值，本作有意不同的写在 why.cd）",
  "version": "国服 2026-04「千海天」/ DFO 2025–2026 现版；满级角色（被动全学满、主动技能满级），默认武器太刀",
  "sources": [
   "wiki.dfo.world 各技能页（英文，有冷却 / 多段数 / 霸体说明）",
   "namu.wiki 각 직업 스킬",
   "dnf.qq.com 官方公告（见 SKILLS_OFFICIAL_sword.md Sources）"
  ],
  "fields": {
   "hits": "[最少, 最多]：轻木桩（身前 70px）被打中的总次数（所有来源：动作 / 投射物 / 召唤物）",
   "launch": "true/false：轻木桩被打到 ≥40px 高",
   "relaunch": "true/false：悬空木桩被追加浮空（命中后上升速度 ≥250）",
   "down": "true/false：轻木桩倒地过",
   "bounce": "true/false：强制弹地",
   "grab": "true/false：抓住轻木桩",
   "sa / invul": "技能自己写的霸体 / 无敌占动作时长的比例：'none' <10%，'part' 10–85%，'full' ≥85%，'any' 不查（地下城里所有技能另有默认霸体，这里查的是决斗场 / 官方原版的）",
   "dx": "[最少, 最多]：向前位移 px（负数 = 后退）",
   "pull": "true/false：一排木桩里有被拉近 ≥30px 的",
   "behind": "true/false：打到身后 80px 的木桩",
   "reach": "[最少, 最多]：打到的最远木桩（70 / 170 / 300 / 450）",
   "cd": "官方冷却（秒），和技能定义比 ±25% 或 ±1s",
   "summon": "true/false：放出召唤物 / 阵",
   "acts": "[最少, 最多]：段数（追加 / 再按产生的动作数）",
   "dur": "[最少, 最多]：技能动作总时长（秒）",
   "atkCancel": "true/false：后摇可以按普攻取消（官方 Basic Attack Cancelable）",
   "why": "{ 字段: 理由 }：本作有意不同的地方，算“已说明”",
   "official / src / en / conf": "官方行为一句话 / 来源 / 英文名 / 置信度（高 = 技能页写明，中 = 推断或单一弱来源）",
   "输入": "pre（先放的技能）、input（tap / hold / mash）、holdT、mashT、hp（施放前 HP 比例）、dir（'f'/'b' 全程按住）、presses（再按时刻）、watch（观察秒数）、at（木桩距离）、air / airDelay（先起跳）",
   "key": "“<id>@<转职>” = 基础技能在该转职下的强化版，只在该转职的表里比对",
   "剑魂命中数": "默认武器太刀：武器奥义 10 级的刺伤每 3 秒引爆一次，剑魂技能的命中数里多算 1 段"
  }
 },
