# 破晓地下城联机服务端配置（复制为 /opt/dawnbreak-server/dawnbreak.env，权限 600）
# 监听地址：只监听本机，由 Caddy 反代 /api/* 和 /ws
DNF_HOST=127.0.0.1
DNF_PORT=18790
# SQLite 数据库文件（目录会自动创建；定期备份这个目录即可）
DNF_DB=/opt/dawnbreak-server/data/dawnbreak.db
# （已弃用）注册不再需要邀请码
# DNF_INVITE=
# 管理员用户名（逗号分隔，不区分大小写）：先注册这个用户名，它就是管理员
DNF_ADMIN=改成房主的用户名
# 在 Caddy 后面：从 X-Forwarded-For 取真实 IP（用于限流）
DNF_TRUST_PROXY=1
# 掉线后保留队伍 / 地下城房间的时间（毫秒），这段时间内重连可以接着玩
DNF_GRACE_MS=20000
# 服务端重启后等队长 / 队员重新登记队伍和房间的时间（毫秒）
DNF_RESTORE_MS=60000
# 1 = 记录每个 HTTP 请求（排查问题时再开）
DNF_LOG_HTTP=0
